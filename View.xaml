<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
 <Grid.Resources>
  <SolidColorBrush x:Key="Accent" Color="#315FC7"/><SolidColorBrush x:Key="Surface" Color="#E7EFFB"/><Color x:Key="CardTop">#E6F8FBFF</Color><Color x:Key="CardBottom">#CCE6F0FC</Color><SolidColorBrush x:Key="PdfAccent" Color="#8052BA"/><SolidColorBrush x:Key="Ink" Color="#202126"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#717179"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="10,0,0,0"/></Style>
  <Style TargetType="Image"><Setter Property="Width" Value="19"/><Setter Property="Height" Value="19"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="22,18"/><Setter Property="BorderBrush" Value="#EDFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource CardTop}" Offset="0"/><GradientStop Color="{DynamicResource CardBottom}" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.06" Color="#202020"/></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="11,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#222228"/><Setter Property="Background" Value="#B8FFFFFF"/><Setter Property="BorderBrush" Value="#1C000000"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Edge" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#65656E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.52"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,5"/><Setter Property="Background" Value="#E6FFFFFF"/><Setter Property="BorderBrush" Value="#20000000"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#CFFFFFFF" BorderBrush="#1C000000" BorderThickness="1" CornerRadius="10"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,10,4"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#FAFAFB" BorderBrush="#D8D8DC" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.52"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="17" Height="17" CornerRadius="5" Background="#AFFFFFFF" BorderBrush="#787880" BorderThickness="1"><TextBlock x:Name="Tick" Text="✓" FontSize="12" Visibility="Collapsed" Foreground="White" HorizontalAlignment="Center"/></Border><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="8,0"/><Setter Property="Foreground" Value="#25252A"/><Setter Property="Background" Value="#C8FFFFFF"/><Setter Property="BorderBrush" Value="#24000000"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.58"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#55555F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Grid.Resources>
 <Border x:Name="GlassTint" CornerRadius="20" Background="{DynamicResource Surface}" BorderBrush="#80FFFFFF" BorderThickness="1"/>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,14,26,20">
  <StackPanel>
   <Grid x:Name="TitleBar" Height="88" Background="Transparent">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="Brand" Width="48" Height="48"/><StackPanel Margin="14,0,0,0"><TextBlock Text="定框截图" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Fixed Frame Capture" Style="{StaticResource Muted}" Margin="1,5,0,0"/></StackPanel></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"><Border Background="#70FFFFFF" CornerRadius="12" Padding="12,5" Margin="0,4,18,0"><TextBlock x:Name="MaterialLabel" Text="GLASS / 3.4" FontSize="10" Foreground="#777780"/></Border><Button x:Name="Minimize" Content="−" Width="36" Height="30" Padding="0" Background="Transparent" BorderBrush="Transparent"/><Button x:Name="CloseToTray" Content="×" Width="36" Height="30" Padding="0" Background="Transparent" BorderBrush="Transparent"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12"><TextBlock Text="主题 / Theme" Style="{StaticResource Muted}" Margin="0,0,10,0"/><ComboBox x:Name="ThemePicker" Width="194" Height="32" ToolTip="即时切换并记住 / Apply and remember"><ComboBoxItem Content="海盐蓝 / Ocean"/><ComboBoxItem Content="薰衣草 / Lavender"/><ComboBoxItem Content="蜜桃橙 / Peach"/><ComboBoxItem Content="经典黑白 / Classic"/></ComboBox></StackPanel>
   </Grid>
   <Grid Height="230"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel x:Name="RegionControls"><StackPanel Orientation="Horizontal"><Image Tag="region"/><TextBlock Text="截图区域 / Capture area" Style="{StaticResource Heading}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,18,0,17"><Button x:Name="SelectRegion" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Image Tag="region"/><TextBlock Text="重新框选&#10;Select area" Margin="8,0,0,0"/></StackPanel></Button><Button x:Name="LocateRegion"><StackPanel Orientation="Horizontal"><Image Tag="move"/><TextBlock Text="按尺寸定位&#10;Position frame" Margin="8,0,0,0"/></StackPanel></Button></StackPanel><UniformGrid Columns="4"><StackPanel Margin="0,0,10,0"><TextBlock Text="左侧 X / Left" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="X"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="顶部 Y / Top" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="Y"/></StackPanel><StackPanel Margin="0,0,10,0"><TextBlock Text="宽度 / Width" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="WidthInput"/></StackPanel><StackPanel><TextBlock Text="高度 / Height" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox x:Name="HeightInput"/></StackPanel></UniformGrid><TextBlock x:Name="RegionInfo" Style="{StaticResource Muted}" Margin="0,13,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><Image Tag="clock"/><TextBlock Text="自动截图 / Auto capture" Style="{StaticResource Heading}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,17,0,14"><TextBlock Text="每隔 / Every" Margin="0,0,12,0"/><TextBox x:Name="Interval" Width="76" TextAlignment="Center"/><TextBlock Text="秒 / seconds" Margin="12,0,0,0"/></StackPanel><Button x:Name="ToggleAuto" Background="#29292F" BorderBrush="#29292F"><StackPanel Orientation="Horizontal"><Image x:Name="AutoIcon" Tag="play:white"/><TextBlock x:Name="AutoButtonText" Text="开始自动截图 / Start" Foreground="White" Margin="8,0,0,0"/></StackPanel></Button><TextBlock x:Name="AutoStatus" Text="未启动 · 等待开始" Style="{StaticResource Muted}" Margin="0,11,0,0"/><TextBlock x:Name="AutoHint" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
   </Grid>
   <Grid Height="334" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel x:Name="FolderControls"><StackPanel Orientation="Horizontal"><Image Tag="folder"/><TextBlock Text="保存位置 / Save folder" Style="{StaticResource Heading}"/></StackPanel><DockPanel Margin="0,16,0,0"><Button x:Name="Browse" DockPanel.Dock="Right" Width="44" Height="36" Padding="0" Margin="10,0,0,0" ToolTip="选择文件夹 / Choose folder"><Image Tag="folder"/></Button><TextBox x:Name="Folder"/></DockPanel></StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel x:Name="NamingControls"><StackPanel Orientation="Horizontal"><Image Tag="tag"/><TextBlock Text="命名与编号 / File naming" Style="{StaticResource Heading}"/></StackPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="NameMode"><ComboBoxItem Content="日期 + 编号 / Date + No."/><ComboBoxItem Content="纯数字 / Number"/><ComboBoxItem Content="自定义 / Custom"/></ComboBox><TextBox x:Name="Template" Grid.Column="2" ToolTip="支持 {date}、{time}、{n}；必须包含 {n}"/></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBlock Text="下一编号&#10;Next number" Style="{StaticResource Muted}" Margin="0,0,10,0"/><TextBox x:Name="Next" Grid.Column="1"/><TextBlock Text="编号位数&#10;Digits" Grid.Column="2" Style="{StaticResource Muted}" Margin="16,0,10,0"/><TextBox x:Name="Digits" Grid.Column="3"/></Grid><TextBlock x:Name="Preview" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border></Grid>
    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel x:Name="KeyControls"><StackPanel Orientation="Horizontal"><Image Tag="key"/><TextBlock Text="全局快捷键 / Hotkeys" Style="{StaticResource Heading}"/></StackPanel><TextBlock Text="单次截图 / Capture" Style="{StaticResource Muted}" Margin="0,21,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><CheckBox x:Name="ShotCtrl" Content="Ctrl"/><CheckBox x:Name="ShotAlt" Content="Alt"/><CheckBox x:Name="ShotShift" Content="Shift"/></StackPanel><ComboBox x:Name="ShotKey" Grid.Column="1"/></Grid><Border Height="1" Background="#18000000" Margin="0,22,0,18"/><TextBlock Text="自动截图 / Start or pause" Style="{StaticResource Muted}" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><CheckBox x:Name="AutoCtrl" Content="Ctrl"/><CheckBox x:Name="AutoAlt" Content="Alt"/><CheckBox x:Name="AutoShift" Content="Shift"/></StackPanel><ComboBox x:Name="AutoKey" Grid.Column="1"/></Grid><Border CornerRadius="12" Background="#60000000" Visibility="Collapsed"/><TextBlock Text="按一下开始，再按一下暂停。&#10;Press to start / pause, even in background." Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,19,0,0"/></StackPanel></Border>
   </Grid>
   <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,14"><StackPanel x:Name="FeedbackControls"><UniformGrid Columns="3"><CheckBox x:Name="SkipDuplicates"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" Margin="0,0,7,0"/><TextBlock Text="跳过重复画面&#10;Skip duplicates"/></StackPanel></CheckBox><CheckBox x:Name="CaptureSound"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" Margin="0,0,7,0"/><TextBlock Text="截图声音&#10;Shutter sound"/></StackPanel></CheckBox><CheckBox x:Name="CaptureNotice"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Margin="0,0,7,0"/><TextBlock Text="截图缩略图提示&#10;Thumbnail preview"/></StackPanel></CheckBox></UniformGrid><TextBlock Text="自动截图仅保存变化画面；手动截图始终保存。提示 3 秒后自动收起。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
   <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions><Button x:Name="Capture" Height="56" Background="#29292F" BorderBrush="#29292F" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Image Tag="capture:white"/><TextBlock Text="立即截图&#10;Capture" Foreground="White" Margin="9,0,0,0"/></StackPanel></Button><Button x:Name="Save" Grid.Column="1" Height="56" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Image Tag="save"/><TextBlock Text="保存设置&#10;Save settings" Margin="8,0,0,0"/></StackPanel></Button><Button x:Name="Background" Grid.Column="2" Height="56" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Image Tag="hide"/><TextBlock Text="后台运行&#10;Background" Margin="8,0,0,0"/></StackPanel></Button><Button x:Name="OpenFolder" Grid.Column="3" Height="56" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Image Tag="folder"/><TextBlock Text="打开目录&#10;Open folder" Margin="8,0,0,0"/></StackPanel></Button><Button x:Name="MergePdf" Grid.Column="4" Height="56" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Image Tag="pdf"/><TextBlock Text="图片合成 PDF&#10;Images to PDF" Margin="8,0,0,0"/></StackPanel></Button><Button x:Name="Exit" Grid.Column="5" Height="56"><StackPanel Orientation="Horizontal"><Image Tag="exit"/><TextBlock Text="退出&#10;Exit" Margin="8,0,0,0"/></StackPanel></Button></Grid>
   <TextBlock x:Name="Status" Style="{StaticResource Muted}" Margin="2,17,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
 </ScrollViewer>
</Grid>
