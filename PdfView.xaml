<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="24">
 <Grid.Resources><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DFDFE5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#99999F"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="84"/><RowDefinition Height="50"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="图片合成 PDF / Images to PDF" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="一张图片一页 · 自动按编号排序 · 可手动调整 · 保留原图片" Style="{DynamicResource Muted}" Margin="0,9,0,0"/></StackPanel>
 <StackPanel x:Name="Tools" Grid.Row="1" Orientation="Horizontal"><Button x:Name="Add" Content="＋ 添加图片" Margin="0,0,8,0"/><Button x:Name="CurrentFolder" Content="截图目录" Margin="0,0,8,0"/><Button x:Name="ChooseFolder" Content="选择文件夹" Margin="0,0,8,0"/><Button x:Name="Sort" Content="按编号排序" Margin="0,0,8,0"/><Button x:Name="Up" Content="↑ 上移 / Up" Margin="0,0,8,0"/><Button x:Name="Down" Content="↓ 下移 / Down" Margin="0,0,8,0"/><Button x:Name="Remove" Content="移除"/></StackPanel>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Style="{DynamicResource Card}" Padding="12"><DockPanel><TextBlock x:Name="Count" DockPanel.Dock="Top" Text="0 张图片" Margin="8,3,0,9" FontWeight="SemiBold"/><ListBox x:Name="Files" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"><ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Path}"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Folder}" FontSize="10" Foreground="#808087" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
  <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions><Border Background="#F5F5F7" CornerRadius="12"><Grid><TextBlock x:Name="Empty" Text="添加图片后在这里预览" Foreground="#88888F" HorizontalAlignment="Center"/><Image x:Name="PreviewImage" Width="Auto" Height="Auto" Stretch="Uniform" Margin="12"/></Grid></Border><TextBlock x:Name="ImageInfo" Grid.Row="1" Style="{DynamicResource Muted}" HorizontalAlignment="Center"/></Grid></Border>
 </Grid>
 <Grid Grid.Row="3" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="页面排版&#10;Page layout" Margin="0,0,16,0"/><ComboBox x:Name="PageMode" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="原图比例 / Original ratio"/><ComboBoxItem Content="A4 / Auto orientation"/></ComboBox><Button x:Name="Export" Grid.Column="3" Content="导出 PDF" Background="#29292F" Foreground="White" Height="48"/></Grid>
 <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ProgressText" Text="支持 PNG、JPG、JPEG、BMP；按文件名数字顺序排列。" Style="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Height="4" Margin="0,7,20,0" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#55555C"/></StackPanel><Button x:Name="OpenPdf" Grid.Column="1" Content="打开 PDF" IsEnabled="False" Height="48" Margin="0,0,10,0"/><Button x:Name="Cancel" Grid.Column="2" Content="关闭 / Close" Height="48"/></Grid>
</Grid>
